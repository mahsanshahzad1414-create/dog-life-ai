<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  />

  <meta
    name="description"
    content="Dog Life AI — a premium interactive virtual dog adventure."
  />

  <meta name="theme-color" content="#0b1020" />

  <title>Dog Life AI — Virtual Dog Adventure</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/style.css" />
</head>

<body>
  <div id="app" class="app-shell">

    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <!-- TOP BAR -->
    <header class="topbar">

      <button
        class="brand"
        id="homeButton"
        type="button"
        aria-label="Open Dog Life home"
      >
        <span class="brand-mark">🐾</span>

        <span class="brand-copy">
          <strong>Dog Life</strong>
          <small>AI Adventure</small>
        </span>
      </button>

      <div class="topbar-center">
        <div class="streak-pill">
          <span>🔥</span>
          <strong id="streakValue">1</strong>
          <span>day streak</span>
        </div>
      </div>

      <div class="topbar-actions">

        <button
          id="soundButton"
          class="icon-button"
          type="button"
          aria-label="Toggle sound"
          title="Toggle sound"
        >
          🔊
        </button>

        <button
          id="profileButton"
          class="profile-button"
          type="button"
          aria-label="Open dog profile"
        >
          <span
            id="profileDog"
            class="profile-avatar"
          >🐶</span>

          <span class="profile-copy">
            <strong id="profileDogName">Luna</strong>
            <small>Explorer</small>
          </span>
        </button>

      </div>
    </header>


    <!-- NAVIGATION -->
    <nav class="main-nav" aria-label="Main navigation">

      <button
        class="nav-item active"
        data-screen="homeScreen"
        type="button"
      >
        <span>🏠</span>
        <strong>Home</strong>
      </button>

      <button
        class="nav-item"
        data-screen="adventureScreen"
        type="button"
      >
        <span>🗺️</span>
        <strong>Adventure</strong>
      </button>

      <button
        class="nav-item"
        data-screen="journalScreen"
        type="button"
      >
        <span>📖</span>
        <strong>Journal</strong>
      </button>

      <button
        class="nav-item"
        data-screen="collectionScreen"
        type="button"
      >
        <span>🏆</span>
        <strong>Collection</strong>
      </button>

      <button
        class="nav-item"
        data-screen="profileScreen"
        type="button"
      >
        <span>👤</span>
        <strong>Profile</strong>
      </button>

    </nav>


    <main class="main-content">


      <!-- HOME -->
      <section
        id="homeScreen"
        class="screen active"
      >

        <div class="hero-grid">

          <div class="hero-copy">

            <span class="eyebrow">
              <span class="live-dot"></span>
              YOUR DOG'S WORLD
            </span>

            <h1>
              Every day is a
              <span class="gradient-text">
                new adventure.
              </span>
            </h1>

            <p class="hero-description">
              Explore, play, train and build an unforgettable bond
              with your AI-powered virtual companion.
            </p>

            <div class="hero-actions">

              <button
                id="startAdventureButton"
                class="primary-button large"
                type="button"
              >
                <span>Start Adventure</span>
                <span class="button-arrow">→</span>
              </button>

              <button
                id="missionButton"
                class="secondary-button large"
                type="button"
              >
                ✨ Quick Mission
              </button>

            </div>

            <div class="hero-meta">

              <div class="meta-item">
                <span>🏅</span>
                <div>
                  <strong>
                    Level <span data-level>1</span>
                  </strong>
                  <small>Explorer</small>
                </div>
              </div>

              <div class="meta-divider"></div>

              <div class="meta-item">
                <span>💛</span>
                <div>
                  <strong id="heroBond">0%</strong>
                  <small>Bond</small>
                </div>
              </div>

            </div>

          </div>


          <!-- HERO DOG -->
          <div class="hero-dog-card">

            <div class="hero-card-glow"></div>

            <div class="hero-card-top">

              <span class="status-badge">
                <span class="status-dot"></span>
                Happy
              </span>

              <button
                id="heroFavoriteButton"
                class="round-action"
                type="button"
                aria-label="Favorite dog"
              >
                ♡
              </button>

            </div>

            <div class="dog-stage">

              <div class="cloud cloud-one"></div>
              <div class="cloud cloud-two"></div>

              <div class="dog-shadow"></div>

              <div
                id="heroDog"
                class="hero-dog"
                aria-label="Your virtual dog"
              >
                🐕
              </div>

              <div class="dog-sparkle sparkle-one">✦</div>
              <div class="dog-sparkle sparkle-two">✧</div>
              <div class="dog-sparkle sparkle-three">✦</div>

            </div>

            <div class="hero-dog-info">

              <div>
                <span class="mini-label">
                  YOUR COMPANION
                </span>

                <h2 id="heroDogName">
                  Luna
                </h2>
              </div>

              <button
                id="editDogButton"
                class="text-button"
                type="button"
              >
                Change dog →
              </button>

            </div>

          </div>

        </div>


        <!-- WELLBEING -->
        <section class="section-block">

          <div class="section-heading">

            <div>
              <span class="eyebrow">TODAY</span>
              <h2>Your dog's wellbeing</h2>
            </div>

          </div>


          <div class="stats-grid">

            <article class="stat-card">

              <div class="stat-icon happiness-icon">
                😊
              </div>

              <div class="stat-content">

                <span>Happiness</span>

                <strong id="stat-happiness">
                  86%
                </strong>

                <div class="progress-track">
                  <div
                    id="bar-happiness"
                    class="progress-fill"
                    style="width:86%"
                  ></div>
                </div>

              </div>

            </article>


            <article class="stat-card">

              <div class="stat-icon energy-icon">
                ⚡
              </div>

              <div class="stat-content">

                <span>Energy</span>

                <strong id="stat-energy">
                  92%
                </strong>

                <div class="progress-track">
                  <div
                    id="bar-energy"
                    class="progress-fill"
                    style="width:92%"
                  ></div>
                </div>

              </div>

            </article>


            <article class="stat-card">

              <div class="stat-icon bond-icon">
                🧠
              </div>

              <div class="stat-content">

                <span>Health</span>

                <strong id="stat-health">
                  96%
                </strong>

                <div class="progress-track">
                  <div
                    id="bar-health"
                    class="progress-fill"
                    style="width:96%"
                  ></div>
                </div>

              </div>

            </article>


            <article class="stat-card">

              <div class="stat-icon xp-icon">
                ✨
              </div>

              <div class="stat-content">

                <span>Experience</span>

                <strong id="xpValue">
                  0 / 100 XP
                </strong>

                <div class="progress-track">
                  <div
                    id="xpBar"
                    class="progress-fill"
                    style="width:0%"
                  ></div>
                </div>

              </div>

            </article>

          </div>

        </section>


        <!-- CARE ACTIONS -->
        <section class="section-block">

          <div class="section-heading">

            <div>
              <span class="eyebrow">
                DAILY CARE
              </span>
              <h2>Take care of your companion</h2>
            </div>

          </div>


          <div class="feature-grid">

            <button
              id="feedButton"
              class="feature-card"
              type="button"
            >
              <span class="feature-icon">🥣</span>

              <span class="feature-copy">
                <small>CARE</small>
                <strong>Feed</strong>
                <span>Give your dog a tasty meal.</span>
              </span>

              <span class="feature-arrow">→</span>
            </button>


            <button
              id="petButton"
              class="feature-card"
              type="button"
            >
              <span class="feature-icon">💜</span>

              <span class="feature-copy">
                <small>BOND</small>
                <strong>Pet</strong>
                <span>Show your companion some love.</span>
              </span>

              <span class="feature-arrow">→</span>
            </button>


            <button
              id="groomButton"
              class="feature-card"
              type="button"
            >
              <span class="feature-icon">🫧</span>

              <span class="feature-copy">
                <small>CARE</small>
                <strong>Groom</strong>
                <span>Keep your dog fresh and clean.</span>
              </span>

              <span class="feature-arrow">→</span>
            </button>


            <button
              id="walkButton"
              class="feature-card"
              type="button"
            >
              <span class="feature-icon">🦮</span>

              <span class="feature-copy">
                <small>OUTDOORS</small>
                <strong>Walk</strong>
                <span>Explore the neighborhood.</span>
              </span>

              <span class="feature-arrow">→</span>
            </button>


            <button
              id="restButton"
              class="feature-card"
              type="button"
            >
              <span class="feature-icon">🛏️</span>

              <span class="feature-copy">
                <small>RECOVER</small>
                <strong>Rest</strong>
                <span>Let your companion recharge.</span>
              </span>

              <span class="feature-arrow">→</span>
            </button>

          </div>

        </section>


        <!-- GOALS -->
        <section class="section-block">

          <div class="section-heading">

            <div>
              <span class="eyebrow">
                DAILY ROUTINE
              </span>
              <h2>Today's goals</h2>
            </div>

          </div>

          <div
            id="goalsGrid"
            class="goals-grid"
          ></div>

        </section>

      </section>


      <!-- ADVENTURE -->
      <section
        id="adventureScreen"
        class="screen"
      >

        <div class="screen-header">

          <div>
            <span class="eyebrow">
              LIVE ADVENTURE
            </span>

            <h1>
              Explore the wild.
            </h1>

            <p>
              Guide your dog through a living world.
            </p>
          </div>

          <div class="adventure-actions">

            <button
              id="pauseGameButton"
              class="secondary-button"
              type="button"
            >
              ⏸ Pause
            </button>

            <button
              id="backHomeButton"
              class="ghost-button"
              type="button"
            >
              Exit
            </button>

          </div>

        </div>


        <!-- GAME HUD -->
        <div class="game-hud">

          <div class="hud-score">
            <span>🦴 Finds</span>
            <strong id="gameProgress">0/10</strong>
          </div>

          <div class="hud-score">
            <span>⭐ Score</span>
            <strong id="gameScore">0</strong>
          </div>

          <div class="hud-timer">
            <span>TIME</span>
            <strong id="gameTimer">90s</strong>
          </div>

        </div>


        <!-- MISSION -->
        <div class="mission-panel">

          <div
            id="missionIcon"
            class="mission-icon"
          >
            ✨
          </div>

          <div class="mission-copy">

            <span>
              AI MISSION DIRECTOR
            </span>

            <strong id="missionTitle">
              Perfect Fetch
            </strong>

            <p id="missionDescription">
              Complete a quick fetch challenge.
            </p>

          </div>

          <button
            id="missionButton"
            class="mission-button"
            type="button"
          >
            Complete mission
          </button>

        </div>


        <!-- CANVAS -->
        <div class="game-wrapper">

          <canvas
            id="gameCanvas"
            width="1200"
            height="680"
            aria-label="Dog Life adventure game"
          ></canvas>


          <!-- RESULT OVERLAY -->
          <div
            id="gameOverlay"
            class="game-overlay hidden"
          >

            <div class="overlay-card">

              <div
                id="overlayIcon"
                class="celebration-icon"
              >
                🏆
              </div>

              <span class="eyebrow">
                ADVENTURE RESULT
              </span>

              <h2 id="overlayTitle">
                Adventure Complete!
              </h2>

              <p id="overlayDescription">
                Your dog had an amazing adventure.
              </p>


              <div class="result-stats">

                <div>
                  <strong id="resultScore">
                    0
                  </strong>
                  <span>Score</span>
                </div>

                <div>
                  <strong id="resultCollected">
                    0/10
                  </strong>
                  <span>Collected</span>
                </div>

                <div>
                  <strong id="resultReward">
                    +0 🪙
                  </strong>
                  <span>Reward</span>
                </div>

              </div>


              <div class="overlay-actions">

                <button
                  id="restartAdventureButton"
                  class="primary-button"
                  type="button"
                >
                  Play again
                </button>

                <button
                  id="backHomeButton"
                  class="secondary-button"
                  type="button"
                >
                  Back home
                </button>

              </div>

            </div>

          </div>

        </div>


        <!-- MOBILE CONTROLS -->
        <div class="game-controls">

          <div class="control-help">

            <span>⌨️</span>

            <p>
              Move with
              <strong>WASD</strong>
              or
              <strong>Arrow Keys</strong>
            </p>

          </div>


          <div class="touch-controls">

            <button
              class="control-up"
              type="button"
              aria-label="Move up"
            >
              ▲
            </button>

            <button
              class="control-left"
              type="button"
              aria-label="Move left"
            >
              ◀
            </button>

            <button
              class="control-down"
              type="button"
              aria-label="Move down"
            >
              ▼
            </button>

            <button
              class="control-right"
              type="button"
              aria-label="Move right"
            >
              ▶
            </button>

          </div>

        </div>

      </section>


      <!-- JOURNAL -->
      <section
        id="journalScreen"
        class="screen"
      >

        <div class="screen-header">

          <div>
            <span class="eyebrow">
              YOUR MEMORIES
            </span>

            <h1>
              Dog Journal
            </h1>

            <p>
              Every adventure becomes a memory.
            </p>
          </div>

          <div class="journal-count">
            <strong id="journalCount">
              0 memories
            </strong>
          </div>

        </div>


        <div
          id="journalEmpty"
          class="empty-state"
        >

          <div class="empty-icon">
            📖
          </div>

          <h2>
            Your story starts here.
          </h2>

          <p>
            Complete your first adventure and your dog's
            memories will appear here.
          </p>

          <button
            id="startAdventureButton"
            class="primary-button"
            type="button"
          >
            Start first adventure
          </button>

        </div>


        <div
          id="journalList"
          class="journal-list"
        ></div>

      </section>


      <!-- COLLECTION -->
      <section
        id="collectionScreen"
        class="screen"
      >

        <div class="screen-header">

          <div>
            <span class="eyebrow">
              REWARDS
            </span>

            <h1>
              Collection
            </h1>

            <p>
              Earn badges by living your best dog life.
            </p>
          </div>

          <div class="collection-score">

            <strong id="badgeScore">
              0 / 8 unlocked
            </strong>

          </div>

        </div>


        <div
          id="badgeGrid"
          class="badge-grid"
        ></div>

      </section>


      <!-- PROFILE -->
      <section
        id="profileScreen"
        class="screen"
      >

        <div class="screen-header">

          <div>
            <span class="eyebrow">
              YOUR COMPANION
            </span>

            <h1>
              Dog Profile
            </h1>

            <p>
              Track your companion's journey.
            </p>
          </div>

        </div>


        <div class="profile-layout">

          <div class="profile-card">

            <div class="profile-visual">

              <div
                id="profileDog"
                class="profile-dog"
              >
                🐕
              </div>

            </div>

            <div class="profile-details">

              <span class="mini-label">
                COMPANION
              </span>

              <h2 id="profileDogName">
                Luna
              </h2>

              <p id="profileDogBreed">
                Golden Retriever
              </p>

              <button
                id="editDogButton"
                class="secondary-button"
                type="button"
              >
                Edit dog
              </button>

            </div>

          </div>


          <div class="profile-stat-grid">

            <div class="profile-stat">
              <span>🧠</span>
              <strong id="profileIntelligence">
                12
              </strong>
              <small>Intelligence</small>
            </div>

            <div class="profile-stat">
              <span>❤️</span>
              <strong id="profileLoyalty">
                20
              </strong>
              <small>Loyalty</small>
            </div>

            <div class="profile-stat">
              <span>🏆</span>
              <strong id="profileAdventures">
                0
              </strong>
              <small>Adventures</small>
            </div>

            <div class="profile-stat">
              <span>⭐</span>
              <strong data-level>
                1
              </strong>
              <small>Level</small>
            </div>

          </div>


          <!-- SETTINGS -->
          <div class="settings-card">

            <div class="settings-heading">

              <div>
                <span class="eyebrow">
                  PREFERENCES
                </span>

                <h2>
                  Settings
                </h2>
              </div>

            </div>


            <label class="setting-row">

              <span>
                <strong>
                  Sound effects
                </strong>

                <small>
                  Play interface and adventure sounds.
                </small>
              </span>

              <input
                id="settingSound"
                type="checkbox"
                checked
              />

              <span class="toggle"></span>

            </label>


            <label class="setting-row">

              <span>
                <strong>
                  Notifications
                </strong>

                <small>
                  Show welcome and game notifications.
                </small>
              </span>

              <input
                id="settingNotifications"
                type="checkbox"
                checked
              />

              <span class="toggle"></span>

            </label>


            <label class="setting-row">

              <span>
                <strong>
                  Reduced motion
                </strong>

                <small>
                  Reduce interface animations.
                </small>
              </span>

              <input
                id="settingReducedMotion"
                type="checkbox"
              />

              <span class="toggle"></span>

            </label>


            <button
              id="resetGameButton"
              class="danger-button"
              type="button"
            >
              Reset local progress
            </button>

          </div>

        </div>

      </section>

    </main>


    <!-- DOG MODAL -->
    <div
      id="dogModal"
      class="modal hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dogModalTitle"
    >

      <div
        class="modal-backdrop"
        data-close-modal
      ></div>

      <div class="modal-card">

        <button
          id="closeDogModal"
          class="modal-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>

        <span class="eyebrow">
          CHOOSE YOUR COMPANION
        </span>

        <h2 id="dogModalTitle">
          Who's joining the adventure?
        </h2>

        <p>
          Choose a breed and give your companion a name.
        </p>


        <div
          id="dogSelectionGrid"
          class="dog-selection-grid"
        ></div>


        <label
          class="input-label"
          for="dogNameInput"
        >
          Dog name
        </label>

        <input
          id="dogNameInput"
          class="text-input"
          type="text"
          maxlength="18"
          placeholder="Enter your dog's name"
          autocomplete="off"
        />


        <button
          id="saveDogButton"
          class="primary-button full"
          type="button"
        >
          Save companion
        </button>

      </div>

    </div>


    <!-- TOAST -->
    <div
      id="toast"
      class="toast"
      role="status"
      aria-live="polite"
    >
      <span>✨</span>
      <span>Welcome to Dog Life!</span>
    </div>


    <!-- LOADING -->
    <div
      id="loadingScreen"
      class="loading-screen"
    >

      <div class="loading-mark">
        🐾
      </div>

      <h1>
        Dog Life
      </h1>

      <p>
        Preparing your next adventure...
      </p>

      <div class="loading-track">
        <div class="loading-bar"></div>
      </div>

    </div>

  </div>


  <script src="/game.js" defer></script>

</body>
</html>
